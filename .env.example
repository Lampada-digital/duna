# ==================================================
# DUNA - Variáveis de Ambiente
# ==================================================
# Copie este arquivo para .env e preencha com seus valores
# NEVER commit .env to version control!

# ==================================================
# SUPABASE (Obrigatório - Backend completo)
# ==================================================
# Crie um projeto em https://supabase.com
# Vá em Settings > API para encontrar estas chaves
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==================================================
# STRIPE (Pagamentos - Opcional mas recomendado)
# ==================================================
# Crie conta em https://stripe.com
# Use modo teste primeiro: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Para webhooks, você precisará de um backend (Supabase Edge Functions)
# STRIPE_SECRET_KEY=sk_test_your_key_here (NUNCA no frontend!)
# STRIPE_WEBHOOK_SECRET=whsec_your_secret_here (NUNCA no frontend!)

# ==================================================
# MAPS (Opcional - Para mapa real)
# ==================================================
# Crie chave em https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_MAPS_KEY=your-google-maps-key

# ==================================================
# EMAIL (Opcional - Supabase envia emails automáticos)
# ==================================================
# Configure em Supabase > Authentication > Email Templates
# Para provider customizado:
# VITE_EMAIL_PROVIDER=resend
# VITE_RESEND_API_KEY=re_your_key_here

# ==================================================
# STORAGE (Supabase Storage - já incluído)
# ==================================================
# Crie buckets no Supabase > Storage:
# - 'property-images' (público)
# - 'avatars' (público)
# - 'documents' (privado)

# ==================================================
# CONFIGURAÇÕES DO SISTEMA
# ==================================================
VITE_APP_NAME=Duna
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_COMMISSION_PERCENTAGE=6
VITE_HOST_FEE_PERCENTAGE=2
VITE_CURRENCY=BRL
VITE_CURRENCY_SYMBOL=R$
